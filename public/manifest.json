{
  "manifest_version": 3,
  "name": "PhoolGuvi — GUVI Auto-Solver & CodeKata Helper",
  "version": "3.2",
  "description": "Auto-solves GUVI course assessments and provides a CodeKata code paste tool via Chrome Side Panel.",
  "permissions": ["storage", "sidePanel", "activeTab"],
  "host_permissions": ["*://*.guvi.in/*"],
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.guvi.in/*"],
      "js": ["content/bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.guvi.in/courses-video*",
        "*://*.guvi.in/courses-video/*"
      ],
      "js": ["content/engine.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.guvi.in/code-kata*",
        "*://*.guvi.in/code-kata/*",
        "*://*.guvi.in/codekata*",
        "*://*.guvi.in/codekata/*"
      ],
      "js": ["content/codekata-engine.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "action": {}
}
