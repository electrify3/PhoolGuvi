{
  "manifest_version": 3,
  "name": "GUVI Direct API Auto-Solver (v3.0)",
  "version": "3.0",
  "description": "Directly uses GUVI's internal authorize.ajax & CourseContent APIs to instant-complete videos, solve quizzes in <1s, and auto-advance.",
  "permissions": ["storage"],
  "host_permissions": ["*://*.guvi.in/*"],
  "content_scripts": [
    {
      "matches": [
        "*://*.guvi.in/courses-video*",
        "*://*.guvi.in/courses-video/*"
      ],
      "css": ["style.css"],
      "js": ["hud-loader.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.guvi.in/courses-video*",
        "*://*.guvi.in/courses-video/*"
      ],
      "js": ["engine.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["hud.html", "style.css"],
      "matches": ["*://*.guvi.in/*"]
    }
  ]
}
