{
  "manifest_version": 3,
  "name": "PhoolGuvi — GUVI Auto-Solver & CodeKata Helper",
  "version": "3.1",
  "description": "Auto-completes GUVI videos, solves quizzes in <1s, auto-advances lessons, and provides a code paste helper for CodeKata challenges.",
  "permissions": ["storage"],
  "host_permissions": ["*://*.guvi.in/*"],
  "content_scripts": [
    {
      "matches": [
        "*://*.guvi.in/courses-video*",
        "*://*.guvi.in/courses-video/*"
      ],
      "css": ["style.css"],
      "js": ["hud-loader.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.guvi.in/courses-video*",
        "*://*.guvi.in/courses-video/*"
      ],
      "js": ["engine.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.guvi.in/code-kata*",
        "*://*.guvi.in/code-kata/*",
        "*://*.guvi.in/codekata*",
        "*://*.guvi.in/codekata/*"
      ],
      "js": ["codekata.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["hud.html", "style.css"],
      "matches": ["*://*.guvi.in/*"]
    }
  ]
}
